# Copies the UI already built on a developer machine.
# The server only packs these files into nginx. It does not run npm install or the React build.
FROM nginx:1.27.0-alpine

COPY prebuilt /usr/share/nginx/html
COPY .env.example /usr/share/nginx/html/.env
COPY nginx-custom.conf /etc/nginx/conf.d/default.conf

RUN apk add --no-cache nodejs npm \
  && npm i -g runtime-env-cra

WORKDIR /usr/share/nginx/html
EXPOSE 3000

CMD ["/bin/sh", "-c", "runtime-env-cra && nginx -g \"daemon off;\""]
